---
import { Icon } from "astro-icon/components";
import ButtonPrimary from "./ButtonPrimary.astro";
import ButtonShine from "./ButtonShine.astro";
import ModalContacto from "./ModalContacto.astro";
import Atmosphere from "./Atmosphere.astro";
import RainbowBorder from "./RainbowBorder.astro";
import videoPoster from "../assets/img/moises-poster.jpg";
import moisesHero1 from "../assets/moi-heroa/moises-b-and-.jpg";
import moisesHero2 from "../assets/moi-heroa/moi-2 (1).jpg";
import moisesHero3 from "../assets/moi-heroa/moi-3.jpg";
import moisesBw1 from "../assets/moises-b-w/moises-bw-1.jpg";
import moisesBw2 from "../assets/moises-b-w/moises-bw-2.jpg";
import moisesBw3 from "../assets/moises-b-w/moises-bw-3.jpg";
import moisesBw4 from "../assets/moises-b-w/moises-bw-4.jpg";

// URL del video que reproduce el modal al abrirse.
// Si es un link de YouTube, el modal lo muestra como embed en 16/9 con autoplay.
const VIDEO_MODAL_URL = "https://youtu.be/oyvbRlG-P0w";

const heroImages = [
    {
        image: moisesHero1,
        alt: "Moisés Magariño",
        className: "h-full w-full object-cover",
    },

    {
        image: moisesBw1,
        alt: "Moisés Magariño en blanco y negro",
        className: "h-full w-full object-cover",
    },
    {
        image: moisesBw2,
        alt: "Moisés Magariño en blanco y negro",
        className: "h-full w-full object-cover",
    },
    {
        image: moisesBw3,
        alt: "Moisés Magariño en blanco y negro",
        className: "h-full w-full object-cover",
    },
    {
        image: moisesBw4,
        alt: "Moisés Magariño en blanco y negro",
        className: "h-full w-full object-cover",
    },
];

// Botón de contacto que muestra el modal debajo del video
const botonesModalContacto = [
    {
        href: "https://wa.link/c24rca",
        text: "Contactar por WhatsApp",
        icon: "whatsapp-solid",
    },
];
---

<section
    id="inicio"
    class="-mt-23 lg:-mt-20 hero min-h-screen lg:h-screen lg:px-10 lg:min-h-[900px] relative isolate w-full overflow-hidden"
>
    <!-- <Atmosphere variant="scoped" /> -->

    <div
        id="video-hero-moises-pc"
        class="hero-video pointer-events-none relative z-0 flex h-[55vh] w-full scale-110 origin-top overflow-hidden p-0 justify-end lg:absolute lg:inset-y-0 lg:right-0 lg:h-full lg:w-1/2 lg:scale-100"
        aria-hidden="true"
    >
        <div id="fade-hero" class="h-full w-full lg:w-[98%]">
            <div
                class="swiper fade-hero-swiper"
                data-fade-hero
                data-fade-delay={3000}
                data-fade-speed={1000}
                aria-label="Galería automática de fotos"
            >
                <div class="swiper-wrapper h-full">
                    {
                        heroImages.map((item, index) => (
                            <div class="swiper-slide fade-hero-slide">
                                <img
                                    src={item.image.src}
                                    class={item.className}
                                    alt={item.alt}
                                    loading={index === 0 ? "eager" : "lazy"}
                                    decoding="async"
                                    draggable="false"
                                />
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
    <div
        class="relative mx-auto flex w-full max-w-7xl flex-col justify-start overflow-hidden lg:h-full lg:flex-row lg:items-stretch lg:justify-between lg:gap-18"
    >
        <div
            class="hero-content relative z-10 mx-auto flex w-full flex-1 items-end px-6 pt-0 lg:h-full lg:items-center lg:self-stretch lg:pt-0"
        >
            <div
                class="hero-copy mx-auto flex lg:max-w-[50%] flex-col pt-4.5 md:pt-0 items-center pb-16 text-center lg:mx-0 lg:items-start lg:pb-32 lg:text-left"
            >
                <RainbowBorder>
                    <span
                        class="w-max whitespace-nowrap px-4 py-1.5 lg:px-3 lg:py-1 text-[.8em] lg:text-[1em] font-extralight text-[#d9dde0]"
                    >
                        Fotógrafo & Filmmaker
                    </span>
                </RainbowBorder>
                <h1
                    class="max-w-xl font-serif text-4xl font-normal leading-[1.02] text-white sm:text-6xl lg:text-7xl xl:text-6xl"
                >
                    Moisés Magariño
                </h1>
                <br />
                <p
                    class="mb-9 w-full lg:w-[80%] text-[.8em] leading-7 text-gray-300 sm:text-lg md:text-[.9em] md:leading-6"
                >
                    Que una propiedad se alquile, que una boda se recuerde, que
                    un concierto vuelva a sentirse: todo empieza con una imagen
                    que emocione. Yo me encargo de que la tuya cuente la
                    historia que merece.
                </p>
                <div
                    class="flex w-full flex-col items-center gap-3 sm:w-fit sm:flex-row lg:items-start"
                >
                    <ButtonPrimary
                        title="Ver Portafolio"
                        link="/galeria/"
                        additionalClass="invert-colors w-full items-center justify-center border border-[#d9dde0] px-5 py-3 text-sm font-medium text-[#202427] transition-colors sm:w-fit"
                        bg="#d9dde0"
                    >
                        <Icon name="camera-icon" size={20} />
                    </ButtonPrimary>

                    <ButtonShine
                        data-modal-open="modal-contacto-hero"
                        href="#"
                        class="w-full flex items-center justify-center border border-[#d9dde0]/70 px-5 py-3 text-sm font-medium text-[#e3e6e8] sm:w-fit"
                        text="Black and White Moments"
                    >
                    </ButtonShine>
                </div>

                <!-- Badge de prueba social: testimonios de clientes -->
                <a
                    href="#testimonios"
                    aria-label="Ver testimonios de clientes"
                    class="mt-8 flex items-center gap-3 rounded-full py-2 pl-2 pr-4 text-inherit no-underline transition-opacity hover:opacity-80"
                >
                    <div class="flex -space-x-2.5" aria-hidden="true">
                        <img
                            src="/images/avatars/heilyn-carolina.jpg"
                            alt=""
                            class="h-8 w-8 rounded-full border-2 border-[#0d0f13] object-cover"
                            loading="lazy"
                            decoding="async"
                            draggable="false"
                        />
                        <img
                            src="/images/avatars/edwing.png"
                            alt=""
                            class="h-8 w-8 rounded-full border-2 border-[#0d0f13] object-cover"
                            loading="lazy"
                            decoding="async"
                            draggable="false"
                        />
                        <img
                            src="/images/avatars/uifaces-human-avatar%20(7).jpg"
                            alt=""
                            class="h-8 w-8 rounded-full border-2 border-[#0d0f13] object-cover"
                            loading="lazy"
                            decoding="async"
                            draggable="false"
                        />
                    </div>
                    <p class="text-[13px] text-gray-300 sm:text-sm">
                        He trabajado con <strong
                            class="font-semibold text-white"
                        >
                            más de 100 personas</strong
                        >
                    </p>
                </a>
            </div>
        </div>
    </div>

    <script>
        import Swiper from "swiper";
        import { EffectFade, Autoplay } from "swiper/modules";
        import "swiper/css";
        import "swiper/css/effect-fade";

        const reduceMotionFade = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        document
            .querySelectorAll<HTMLElement>("[data-fade-hero]")
            .forEach((el) => {
                const slides = el.querySelectorAll(".swiper-slide").length;
                const delay = Number(el.dataset.fadeDelay) || 3000;
                const speed = Number(el.dataset.fadeSpeed) || 1000;

                if (slides < 2) return;
                if (reduceMotionFade) return;

                new Swiper(el, {
                    modules: [EffectFade, Autoplay],
                    effect: "fade",
                    fadeEffect: {
                        crossFade: true,
                    },
                    speed,
                    loop: true,
                    autoplay: {
                        delay,
                        disableOnInteraction: false,
                    },
                    noSwiping: true,
                    allowTouchMove: false,
                    simulateTouch: false,
                });
            });

        /* ========= Blur del hero ligado al scroll =========
         * Al BAJAR, todo (texto + galería) se difumina progresivamente;
         * al SUBIR regresa a su estado original. `scrub: true` liga el
         * blur al progreso del scroll, así el efecto es reversible por
         * naturaleza: no es una animación de una sola vez, es un "dial"
         * que sigue al scroll en ambas direcciones.
         */
        import gsap from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";

        gsap.registerPlugin(ScrollTrigger);

        const hero = document.querySelector(".hero");
        const heroContent = document.querySelector(".hero-content");
        const heroGallery = document.querySelector("#video-hero-moises-pc");
        const respetaReduceMovimiento = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        if (hero && heroContent && !respetaReduceMovimiento) {
            const targets = [heroContent];
            if (heroGallery) targets.push(heroGallery);

            gsap.to(targets, {
                filter: "blur(12px)",
                ease: "none",
                scrollTrigger: {
                    trigger: hero,
                    // empieza un poco después de bajar para que el hero
                    // siga nítido al entrar; termina cuando sale de pantalla
                    start: "top+=150 top",
                    end: "bottom top",
                    scrub: true,
                },
            });
        }
    </script>

    <style>
        .hero-content,
        #video-hero-moises-pc {
            will-change: filter;
        }

        .fade-hero-swiper {
            box-sizing: border-box;
            width: 100%;
            max-width: 100%;
            min-width: 0;
            height: 100%;
            overflow: hidden;
        }

        .fade-hero-swiper .swiper-slide {
            filter: blur(14px);
            transition-property: opacity, filter;
        }

        .fade-hero-swiper .swiper-slide-active {
            filter: blur(0);
        }

        .fade-hero-swiper .fade-hero-slide img {
            display: block;
            height: 100%;
            width: 100%;
            object-fit: cover;
            object-position: center top;
            user-select: none;
        }

        /*
            Máscara de fundido (solo móvil): la foto se desvanece en sus
            bordes verticales (arriba leve, abajo pronunciado) para fundirse
            con el fondo de la web. Va en cada <img> — no en el contenedor —
            para no interferir con el filter/opacity que GSAP anima sobre
            #video-hero-moises-pc ni con los transforms del Swiper.
        */
        @media (max-width: 1023px) {
            .fade-hero-swiper .fade-hero-slide img {
                -webkit-mask-image: linear-gradient(
                    to bottom,
                    transparent 0%,
                    rgba(0, 0, 0, 0.45) 12%,
                    #000 30%,
                    #000 48%,
                    rgba(0, 0, 0, 0.8) 66%,
                    rgba(0, 0, 0, 0.45) 84%,
                    transparent 100%
                );
                mask-image: linear-gradient(
                    to bottom,
                    transparent 0%,
                    rgba(0, 0, 0, 0.45) 12%,
                    #000 30%,
                    #000 48%,
                    rgba(0, 0, 0, 0.8) 66%,
                    rgba(0, 0, 0, 0.45) 84%,
                    transparent 100%
                );
            }
        }

        /*
            Máscara (solo desktop >= lg): funde el borde IZQUIERDO y el
            INFERIOR de la galería con el fondo de la web. Son dos capas de
            máscara (una por borde) combinadas con mask-composite:
            intersect — la intersección hace que ambos bordes se
            desvanezcan a la vez conservando el centro sólido.
        */
        @media (min-width: 1024px) {
            .fade-hero-swiper .fade-hero-slide img {
                -webkit-mask-image:
                    linear-gradient(to right, transparent 0%, #000 28%),
                    linear-gradient(to top, transparent 0%, #000 32%);
                -webkit-mask-composite: source-in;
                mask-image:
                    linear-gradient(to right, transparent 0%, #000 28%),
                    linear-gradient(to top, transparent 0%, #000 32%);
                mask-composite: intersect;
            }
        }

        .hero {
            background: var(--color-bg);
        }
    </style>
</section>

<!-- Modal de contacto: se abre al hacer click en el botón de WhatsApp del hero -->
<ModalContacto
    id="modal-contacto-hero"
    videoSrc={VIDEO_MODAL_URL}
    poster={videoPoster.src}
    buttons={botonesModalContacto}
/>
