---
interface Props {
    title: string;
    eyebrow: string;
    description: string;
    updated: string;
}

const { title, eyebrow, description, updated } = Astro.props;
---

<section class="legal-shell">
    <div class="legal-heading">
        <p class="legal-eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="legal-description">{description}</p>
        <p class="legal-date">Última actualización: {updated}</p>
    </div>
    <article class="legal-copy">
        <slot />
    </article>
</section>

<style>
    .legal-shell {
        width: min(100% - 2rem, 56rem);
        margin: 0 auto;
        padding: clamp(4rem, 9vw, 8rem) 0;
        color: #c3c7ca;
    }

    .legal-heading {
        padding-bottom: 2rem;
        border-bottom: 1px solid rgb(217 220 223 / 20%);
    }

    .legal-eyebrow {
        margin: 0 0 1rem;
        color: #a7adb4;
        font-size: 0.75rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
    }

    h1 {
        margin: 0;
        color: #f3f4f6;
        font-size: clamp(2.5rem, 8vw, 5rem);
        font-weight: 500;
        letter-spacing: -0.06em;
        line-height: 1;
    }

    .legal-description {
        max-width: 42rem;
        margin: 1.5rem 0 0;
        color: #d9dcdf;
        font-size: clamp(1rem, 2vw, 1.25rem);
        line-height: 1.7;
    }

    .legal-date {
        margin: 1rem 0 0;
        color: #9299a1;
        font-size: 0.875rem;
    }

    .legal-copy {
        display: grid;
        gap: 1.75rem;
        padding-top: 2rem;
        font-size: 1rem;
        line-height: 1.8;
    }

    .legal-copy :global(h2) {
        margin: 0 0 0.5rem;
        color: #f3f4f6;
        font-size: 1.25rem;
        font-weight: 500;
        letter-spacing: -0.02em;
    }

    .legal-copy :global(p),
    .legal-copy :global(ul) {
        margin: 0;
    }

    .legal-copy :global(ul) {
        padding-left: 1.25rem;
    }

    .legal-copy :global(li + li) {
        margin-top: 0.5rem;
    }

    .legal-copy :global(a) {
        color: #f3f4f6;
        text-underline-offset: 0.2em;
    }
</style>
