---
/**
 * Galería parallax de videos de fondo con el nombre "Moisés Magariño"
 * centrado encima.
 *
 * - Los videos viven en `src/assets/videos-moises` y los importa Astro
 *   (URL con hash en build, cero configuración).
 * - Carga perezosa real: los <video> nacen sin `src` (preload="none"),
 *   y un único IntersectionObserver asigna el `src` + reproduce solo
 *   cuando el tile entra en pantalla (con 200px de anticipación).
 *   Al salir de pantalla se pausa (ahorra CPU/batería/datos).
 * - El alto de la sección crece con la cantidad de videos por columna
 *   vía la variable `--tiles` (ver CSS de .parallax-gallery).
 * - Con `prefers-reduced-motion` no se carga ni reproduce nada: los
 *   tiles quedan como placeholders oscuros.
 */

/**
 * TODO (pendiente): pósters de los videos.
 *
 * Hoy los tiles muestran el placeholder `bg-[#0d0f13]` hasta que el
 * primer frame del video está listo. Para evitar ese instante oscuro,
 * generar un póster por video con FFmpeg y pasarlo al atributo
 * `poster` de cada <video>:
 *
 * @example
 * ffmpeg -ss 0.5 -i "video.mp4" -frames:v 1 -q:v 2 poster.jpg
 */

import video2 from "../assets/videos-moises/video_2026-11-10_18-56-48 (2).mp4";
import video5 from "../assets/videos-moises/video_2026-11-10_18-56-48 (5).mp4";
import video10 from "../assets/videos-moises/video_2026-11-10_18-56-48 (10).mp4";
import video19 from "../assets/videos-moises/video_2026-11-10_18-56-48 (4).mp4";
import video22 from "../assets/videos-moises/video_2026-11-10_18-56-48 (22).mp4";
import video26 from "../assets/videos-moises/video_2026-11-10_18-56-48 (26).mp4";
import video27 from "../assets/videos-moises/video_2026-11-10_18-56-48 (27).mp4";
import video30 from "../assets/videos-moises/video_2026-11-10_18-56-48 (30).mp4";

const columns = [
  {
    videos: [video26, video19, video26],
    top: "top-0",
    speed: 1.2,
  },
  {
    videos: [video27, video10, video27],
    top: "-top-[15%]",
    speed: 1.6,
  },
  {
    videos: [video22, video30, video22],
    top: "-top-[8%]",
    speed: 1.35,
  },
  {
    videos: [video2, video5, video2],
    top: "-top-[12%]",
    speed: 1.5,
  },
];

// Cantidad de tiles por columna → define el alto de la sección (CSS).
const tilesPerColumn = Math.max(...columns.map((col) => col.videos.length));

// Vista móvil: todos los videos únicos (sin repeticiones), sean 8 o los
// que sean, en un grid de 2 columnas. El alto del contenedor lo define
// el contenido (aspect-ratio 9/16 por tile), no el viewport.
const uniqueVideos = [
  video26,
  video19,
  video27,
  video10,
  video22,
  video30,
  video2,
  video5,
];
---

<div class="w-full lg:pt-50">
  <!-- ===== Vista móvil (< lg): grid de 2 columnas con todos los
             videos únicos, sin parallax. El alto lo define el contenido
             (aspect-ratio 9/16 por tile), no el viewport. El nombre
             queda sticky en pantalla mientras la pila scrollea detrás.
             ===== -->
  <div class="relative lg:hidden">
    <div class="pointer-events-none sticky top-[35vh] z-10 flex justify-center">
      <p
        class="parallax-name parallax-name-mobile relative text-center font-serif text-5xl leading-[1.02] text-white sm:text-6xl"
      >
        <span class="parallax-name-glow absolute inset-0" aria-hidden="true">
        </span>
        <span class="relative">Moisés Magariño</span>
      </p>
    </div>
    <div class="grid grid-cols-2 gap-2 p-2">
      {
        uniqueVideos.map((src) => (
          <div class="relative aspect-[9/16] w-full overflow-hidden bg-[#0d0f13] [&:last-child:nth-child(odd)]:col-span-2">
            <video
              class="pointer-events-none h-full w-full object-cover"
              muted
              loop
              playsinline
              preload="none"
              disablepictureinpicture
              data-src={src}
              aria-hidden="true"
            ></video>
          </div>
        ))
      }
    </div>
  </div>

  <!-- ===== Vista escritorio (>= lg): 4 columnas con parallax ===== -->
  <div
    data-parallax-gallery
    class="parallax-gallery relative hidden gap-[2vw] overflow-hidden p-[2vw] lg:flex"
    style={`--tiles: ${tilesPerColumn}`}
  >
    {
      columns.map((col, i) => (
        <div
          class:list={[
            "parallax-col relative flex w-1/4 min-w-[250px] flex-col gap-[2vw]",
            col.top,
          ]}
          data-speed={col.speed}
        >
          {col.videos.map((src) => (
            <div class="parallax-tile relative w-full overflow-hidden bg-[#0d0f13]">
              <video
                class="pointer-events-none h-full w-full object-cover"
                muted
                loop
                playsinline
                preload="none"
                disablepictureinpicture
                data-src={src}
                aria-hidden="true"
              ></video>
            </div>
          ))}
        </div>
      ))
    }

    <!-- Nombre centrado con fondo elíptico: centro oscuro translúcido
             que se funde a transparente en los lados -->
    <div
      class="pointer-events-none absolute inset-0 z-10 flex items-center justify-center"
    >
      <p
        class="parallax-name relative font-serif text-4xl leading-[1.02] text-white sm:text-6xl lg:text-7xl"
      >
        <span class="parallax-name-glow absolute inset-0" aria-hidden="true">
        </span>
        <span class="relative">Moisés Magariño</span>
      </p>
    </div>
  </div>
</div>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initializeParallaxGallery() {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (reduceMotion) return;

    // Carga perezosa de videos (ambas maquetaciones): un único
    // IntersectionObserver vigila todos los tiles. Al acercarse (200px
    // antes de entrar) descarga el video; al salir de pantalla lo pausa.
    // Sin src asignado, el navegador descarga 0 bytes (preload="none").
    // La maqueta oculta (display:none) nunca intersecta, así que no se
    // carga nada dos veces entre móvil y escritorio.
    const videos =
      document.querySelectorAll<HTMLVideoElement>("video[data-src]");

    const videoObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            if (!video.getAttribute("src")) {
              video.src = video.dataset.src ?? "";
              video.load();
            }
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      },
      { rootMargin: "200px", threshold: 0.1 },
    );

    videos.forEach((video) => videoObserver.observe(video));

    // Animaciones según breakpoint: gsap.matchMedia las crea y destruye
    // al cruzar el límite de lg, evitando triggers sobre elementos
    // ocultos (display:none).
    const mm = gsap.matchMedia();

    mm.add("(min-width: 1024px)", () => {
      const gallery = document.querySelector<HTMLElement>(
        "[data-parallax-gallery]",
      );
      if (!gallery) return;

      // Parallax: cada columna baja a su propia velocidad (proporcional
      // a innerHeight, leída de data-speed) mientras dura el scroll.
      gallery.querySelectorAll<HTMLElement>(".parallax-col").forEach((col) => {
        const speed = Number(col.dataset.speed) || 1.2;
        gsap.to(col, {
          y: () => window.innerHeight * speed,
          ease: "none",
          scrollTrigger: {
            trigger: gallery,
            start: "top bottom",
            end: "bottom top",
            scrub: true,
          },
        });
      });

      // El nombre entra con un "reveal wipe" (cortina de izquierda a
      // derecha) cuando entra en pantalla. `once: true` para que solo
      // se reproduzca la primera vez.
      const name = gallery.querySelector<HTMLElement>(".parallax-name");
      if (name) {
        gsap.from(name, {
          clipPath: "inset(0 100% 0 0)",
          duration: 1.2,
          ease: "power3.inOut",
          scrollTrigger: {
            trigger: name,
            start: "top 90%",
            once: true,
          },
        });
      }
    });

    mm.add("(max-width: 1023.98px)", () => {
      // Reveal wipe del nombre sticky en móvil (sin parallax).
      const mobileName = document.querySelector<HTMLElement>(
        ".parallax-name-mobile",
      );
      if (mobileName) {
        gsap.from(mobileName, {
          clipPath: "inset(0 100% 0 0)",
          duration: 1.2,
          ease: "power3.inOut",
          scrollTrigger: {
            trigger: mobileName,
            start: "top 90%",
            once: true,
          },
        });
      }
    });

    window.addEventListener("resize", () => {
      ScrollTrigger.refresh();
    });
  }

  initializeParallaxGallery();
</script>

<style>
  .parallax-col {
    will-change: transform;
  }

  /*
    Alto dinámico de la sección: crece con la cantidad de tiles por
    columna. `--tiles` llega por inline style desde el frontmatter
    (tilesPerColumn), así que agregar videos hace la sección más alta
    sin tocar CSS. La fórmula replica la maqueta: N tiles + N-1 gaps
    de 2vw + padding de 2vw arriba y abajo.
  */
  .parallax-gallery {
    --tile-h: 80vh;
    height: calc(var(--tiles) * var(--tile-h) + (var(--tiles) - 1) * 2vw + 4vw);
  }

  .parallax-tile {
    height: var(--tile-h);
  }

  /*
    Viñeta elíptica centrada en el nombre: núcleo oscuro que se funde
    a transparente hacia los bordes, destacando al texto blanco.
  */
  .parallax-name {
    /* elipse holgada alrededor del texto */
    padding: 3rem 5rem;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.95);

    clip-path: inset(0 0% 0 0);
  }

  .parallax-name-glow {
    background-image: radial-gradient(
      ellipse 80% 50% at 50% 50%,
      rgba(0, 0, 0, 0.95) 0%,
      rgba(0, 0, 0, 0) 70%
    );
  }

  /* En pantallas pequeñas el padding holgado de la elipse es
     demasiado ancho: lo reducimos para que el glow siga al texto. */
  @media (max-width: 640px) {
    .parallax-name {
      padding: 1.5rem 2rem;
    }
  }
</style>
