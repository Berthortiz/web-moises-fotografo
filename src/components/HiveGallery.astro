

import { getImage, type ImageMetadata } from "astro:assets";

const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/pagina web fotos y video/web photoshoot/*.{jpg,JPG,jpeg,JPEG}",
  { eager: true },
);

const modulesFeatured = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/imagenes-destacadas/*.{jpg,JPG,jpeg,JPEG}",
  { eager: true },
);

const CELL_COUNT = 24;
const CELL_SIZES = "(max-width: 1024px) 22vw, 250px"; // círculos ~70/220px

interface Cell {
  thumb: string;
  srcset: string;
  alt: string;
}


const photos = [...Object.values(modules), ...Object.values(modulesFeatured)]
  .map((m) => m.default)
  .filter(Boolean)
  .sort((a, b) =>
    a.src.split("/").pop()!.localeCompare(b.src.split("/").pop()!),
  );

const gallery: Cell[] = [];

if (photos.length > 0) {
  // Submuestreo con paso uniforme: 24 fotos únicas (si hay suficientes)
  const selected: ImageMetadata[] = [];
  if (photos.length <= CELL_COUNT) {
    selected.push(...photos);
  } else {
    for (let i = 0; i < CELL_COUNT; i++) {
      selected.push(photos[Math.floor((i * photos.length) / CELL_COUNT)]!);
    }
  }

  // Igual que gallery.ts: 480px (1x) + 960px (2x retina), WebP
  const cells = await Promise.all(
    selected.map(async (meta, i) => {
      const thumb1x = await getImage({
        src: meta,
        width: 480,
        format: "webp",
        quality: 75,
      });
      const thumb2x = await getImage({
        src: meta,
        width: 960,
        format: "webp",
        quality: 75,
      });
      return {
        thumb: thumb1x.src,
        srcset: `${thumb1x.src} 480w, ${thumb2x.src} 960w`,
        alt: `Foto ${i + 1} de la galería de Moisés Magariño`,
      };
    }),
  );
  gallery.push(...cells);
}

// Filas de la colmena: escala (k) de cada celda, igual que el HTML original
const rows: { k: number }[][] = [
  [{ k: 0.71 }, { k: 0.8 }, { k: 0.84 }, { k: 0.8 }, { k: 0.71 }],
  [{ k: 0.7 }, { k: 0.81 }, { k: 0.92 }, { k: 0.92 }, { k: 0.81 }, { k: 0.7 }],
  [
    { k: 0.64 },
    { k: 0.75 },
    { k: 0.87 },
    { k: 0.95 },
    { k: 0.87 },
    { k: 0.75 },
    { k: 0.64 },
  ],
  [
    { k: 0.66 },
    { k: 0.76 },
    { k: 0.83 },
    { k: 0.83 },
    { k: 0.76 },
    { k: 0.66 },
  ],
];

// Distribuir las fotos en las filas
let index = 0;
const hive = rows.map((row) => {
  return row.map(() => {
    const cell = gallery[index % Math.max(gallery.length, 1)];
    index++;
    return { cell };
  });
});
---

<section class="hive-section" aria-label="Galería de fotos de Moisés Magariño">
  <div class="watch">
    <div class="hive">
      {
        hive.map((row, i) => (
          <div class="row">
            {row.map(({ cell }, j) => (
              <img
                class="cell"
                style={`--k:${rows[i][j].k}`}
                src={cell?.thumb}
                srcset={cell?.srcset}
                sizes={CELL_SIZES}
                alt={cell?.alt ?? ""}
                loading="lazy"
                decoding="async"
              />
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hive-section {
    /* background: #111; */
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  /* Pantalla 16:9 que ocupa casi toda la ventana */
  .watch {
    --w: min(96vw, calc(94vh * 16 / 9)); /* ancho: el mayor 16:9 que quepa */
    --s: calc(var(--w) / 8); /* diámetro del círculo central */
    --g: calc(var(--s) * 0.05); /* espacio entre círculos */
    width: var(--w);
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 3%;
    border: clamp(3px, 0.5vw, 8px) solid #2a2a2c;
    box-sizing: border-box;
    display: grid;
    place-items: center;
    overflow: visible;
  }

  /* ====== LA GALERÍA ====== */
  .hive {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .row {
    display: flex;
    gap: var(--g);
  }
  .row + .row {
    margin-top: calc((var(--s) + var(--g)) * 0.866 - var(--s));
  }
  .row .cell {
    display: block;
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
    transform: scale(var(--k));
    transition:
      transform 0.3s cubic-bezier(0.2, 0.8, 0.3, 1.2),
      border-radius 0.3s ease,
      filter 0.3s ease,
      box-shadow 0.3s ease;
    cursor: pointer;
  }

  /* Previsualización grande al pasar el cursor: se quita el recorte
     circular y la foto se ve COMPLETA en su relación de aspecto original
     (contain). Las bandas sobrantes de la caja se funden en negro. */
  .row .cell:hover {
    border-radius: 0;
    object-fit: contain;
    /* background: #000; */
    transform: scale(2.2);
    position: relative;
    z-index: 10;
    /* box-shadow:
      0 8px 30px rgba(0, 0, 0, 0.7),
      0 0 0 2px rgba(255, 255, 255, 0.85); */
  }
  .hive:hover .row .cell:not(:hover) {
    filter: brightness(0.55);
  }

  /* ====== TABLET Y MENOR: filas de 4 y 3, los demás bajan ====== */
  @media (max-width: 1024px) {
    .hive-section {
      overflow-x: clip;
    }
    .watch {
      --s: calc(min(94vw, 760px) / 4.9); /* círculo según el ancho */
      --g: calc(var(--s) * 0.05);
      --p: calc(var(--s) + var(--g)); /* paso horizontal */
      --r: calc(var(--p) * 1.732); /* altura de 2 filas */
      width: fit-content;
      aspect-ratio: auto; /* deja de ser 16:9 */
      display: flex;
      align-items: stretch;
      padding: calc(var(--s) * 0.3);
      border-radius: calc(var(--s) * 0.6);
      margin: 3vw 0;
    }
    .hive {
      display: block;
      width: calc(var(--p) * 4 + 2px);
      font-size: 0;
    }
    /* Truco del float: empuja las filas pares media celda */
    .hive::before {
      content: "";
      float: left;
      width: calc(var(--p) / 2);
      height: 100%;
      shape-outside: repeating-linear-gradient(
        transparent 0 calc(var(--r) - 3px),
        #fff 0 var(--r)
      );
    }
    .row {
      display: contents; /* los círculos fluyen libres */
    }
    .row + .row {
      margin-top: 0;
    }
    .row .cell {
      display: inline-block;
      margin: 0 calc(var(--g) / 2) calc(var(--p) * 0.866 - var(--s));
      transform: none; /* todos del mismo tamaño */
    }
    .row .cell:hover,
    .row .cell:active {
      border-radius: 0;
      object-fit: contain;
      background: #000;
      transform: scale(1.7);
      position: relative;
      z-index: 10;
    }
  }
</style>
