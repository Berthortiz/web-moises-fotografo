<dialog id="cookie-consent-dialog" class="cookie-dialog" aria-labelledby="cookie-title">
    <div class="cookie-content">
        <button
            id="cookie-close"
            class="cookie-close"
            type="button"
            aria-label="Cerrar preferencias"
            hidden
        >×</button>
        <p class="cookie-eyebrow">Tu privacidad importa</p>
        <h2 id="cookie-title">Tú decides qué guardar.</h2>
        <p class="cookie-copy">
            Utilizamos cookies y tecnologías similares para que el sitio funcione
            correctamente y recordar tus preferencias. Actualmente no activamos
            cookies de analítica ni publicidad. Puedes aceptar todas, rechazar las
            opcionales o personalizar tu elección. Consulta nuestras políticas de
            cookies y privacidad para más información.
        </p>
        <p id="cookie-status" class="cookie-status" role="status" aria-live="polite"></p>

        <section id="cookie-options" class="cookie-options" hidden aria-label="Categorías de cookies">
            <div class="cookie-option">
                <div>
                    <h3>Necesarias</h3>
                    <p>Guardan tu elección de privacidad y no se pueden desactivar.</p>
                </div>
                <span class="cookie-required">Siempre activas</span>
            </div>
            <div class="cookie-option">
                <div>
                    <h3>Analítica y contenido opcional</h3>
                    <p>
                        No hay herramientas de seguimiento opcionales activas en este
                        momento. La elección se guarda para futuras visitas.
                    </p>
                </div>
                <label class="cookie-toggle">
                    <span class="sr-only">Permitir categorías opcionales</span>
                    <input id="cookie-optional-toggle" type="checkbox" />
                    <span aria-hidden="true"></span>
                </label>
            </div>
        </section>

        <div class="cookie-actions">
            <button id="cookie-accept" class="cookie-button cookie-button-primary" type="button">
                Aceptar todas
            </button>
            <button id="cookie-reject" class="cookie-button" type="button">
                Solo necesarias
            </button>
            <button
                id="cookie-customize"
                class="cookie-button cookie-button-text"
                type="button"
                aria-expanded="false"
                aria-controls="cookie-options"
            >
                Configurar
            </button>
            <button
                id="cookie-save-preferences"
                class="cookie-button cookie-button-text"
                type="button"
                hidden
            >
                Guardar selección
            </button>
        </div>
        <p class="cookie-policy">
            Consulta la <a href="/politica-de-cookies/">Política de cookies</a> y la
            <a href="/privacidad/">Política de privacidad</a>.
        </p>
    </div>
</dialog>

<script>
    type Consent = {
        version: 1;
        optional: boolean;
        savedAt: string;
    };

    const dialog = document.querySelector<HTMLDialogElement>("#cookie-consent-dialog");
    const status = document.querySelector<HTMLElement>("#cookie-status");
    const options = document.querySelector<HTMLElement>("#cookie-options");
    const toggle = document.querySelector<HTMLInputElement>("#cookie-optional-toggle");
    const customizeButton = document.querySelector<HTMLButtonElement>("#cookie-customize");
    const savePreferencesButton = document.querySelector<HTMLButtonElement>(
        "#cookie-save-preferences",
    );
    const closeButton = document.querySelector<HTMLButtonElement>("#cookie-close");
    const storageKey = "moises-cookie-consent-v1";

    const isConsent = (value: unknown): value is Consent =>
        typeof value === "object" &&
        value !== null &&
        "version" in value &&
        value.version === 1 &&
        "optional" in value &&
        typeof value.optional === "boolean" &&
        "savedAt" in value &&
        typeof value.savedAt === "string";

    if (
        dialog &&
        status &&
        options &&
        toggle &&
        customizeButton &&
        savePreferencesButton &&
        closeButton
    ) {
        const getConsent = (): Consent | null => {
            const rawConsent = window.localStorage.getItem(storageKey);
            if (!rawConsent) return null;

            try {
                const consent: unknown = JSON.parse(rawConsent);
                return isConsent(consent) ? consent : null;
            } catch (error) {
                console.error("No se pudieron leer las preferencias de cookies.", error);
                return null;
            }
        };

        const openPreferences = (force = true) => {
            let consent: Consent | null = null;
            try {
                consent = getConsent();
            } catch (error) {
                console.error("No se pudo acceder al almacenamiento de preferencias.", error);
                status.textContent =
                    "El almacenamiento está bloqueado. Puedes continuar sin guardar preferencias.";
            }
            if (consent && !force) return;
            closeButton.hidden = !consent;
            toggle.checked = consent?.optional ?? false;
            if (consent) status.textContent = "";
            options.hidden = true;
            savePreferencesButton.hidden = true;
            customizeButton.textContent = "Configurar";
            customizeButton.setAttribute("aria-expanded", "false");
            if (!dialog.open) dialog.showModal();
        };

        const saveConsent = (optional: boolean) => {
            const consent: Consent = {
                version: 1,
                optional,
                savedAt: new Date().toISOString(),
            };

            try {
                window.localStorage.setItem(storageKey, JSON.stringify(consent));
                dialog.close();
            } catch (error) {
                console.error("No se pudieron guardar las preferencias de cookies.", error);
                status.textContent =
                    "No pudimos guardar tu elección en este navegador. Revisa la configuración de almacenamiento e inténtalo de nuevo.";
            }
        };

        document.querySelector("#cookie-accept")?.addEventListener("click", () => {
            saveConsent(true);
        });
        document.querySelector("#cookie-reject")?.addEventListener("click", () => {
            saveConsent(false);
        });
        savePreferencesButton.addEventListener("click", () => {
            saveConsent(toggle.checked);
        });
        document.querySelector("#cookie-close")?.addEventListener("click", () => {
            dialog.close();
        });
        customizeButton.addEventListener("click", () => {
            options.hidden = !options.hidden;
            savePreferencesButton.hidden = options.hidden;
            customizeButton.textContent = options.hidden ? "Configurar" : "Ocultar configuración";
            customizeButton.setAttribute("aria-expanded", String(!options.hidden));
        });

        document.addEventListener("click", (event) => {
            const target = event.target;
            if (target instanceof Element && target.closest("[data-cookie-settings]")) {
                event.preventDefault();
                openPreferences();
            }
        });

        openPreferences(false);
    }
</script>

<style>
    .cookie-dialog {
        position: fixed;
        inset: auto auto 1rem 1rem;
        width: min(calc(100vw - 2rem), 27rem);
        max-height: min(78dvh, 40rem);
        margin: 0;
        padding: 0;
        overflow: auto;
        color: #c3c7ca;
        background: #111318;
        border: 1px solid rgb(217 220 223 / 20%);
        box-shadow: 0 0.75rem 2.5rem rgb(0 0 0 / 38%);
    }

    .cookie-dialog::backdrop {
        background: rgb(5 6 8 / 18%);
    }

    .cookie-content {
        position: relative;
        padding: 1.35rem 1.4rem;
    }

    .cookie-eyebrow {
        margin: 0 0 0.5rem;
        color: #a7adb4;
        font-size: 0.65rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
    }

    .cookie-content h2 {
        margin: 0;
        color: #f3f4f6;
        font-size: clamp(1.5rem, 4vw, 1.8rem);
        font-weight: 500;
        letter-spacing: -0.05em;
    }

    .cookie-copy,
    .cookie-policy,
    .cookie-option p {
        color: #b6bbc1;
        font-size: 0.9rem;
        line-height: 1.65;
    }

    .cookie-copy {
        margin: 0.65rem 0 0;
        font-size: 0.82rem;
    }

    .cookie-status {
        min-height: 1rem;
        margin: 0.5rem 0 0;
        color: #f3f4f6;
        font-size: 0.75rem;
    }

    .cookie-options {
        margin-top: 0.65rem;
        border-top: 1px solid rgb(217 220 223 / 16%);
    }

    .cookie-options[hidden] {
        display: none;
    }

    .cookie-option {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.7rem 0;
        border-bottom: 1px solid rgb(217 220 223 / 16%);
    }

    .cookie-option h3 {
        margin: 0;
        color: #f3f4f6;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .cookie-option p {
        margin: 0.35rem 0 0;
        font-size: 0.72rem;
    }

    .cookie-required {
        flex: 0 0 auto;
        color: #d9dcdf;
        font-size: 0.75rem;
    }

    .cookie-toggle input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
    }

    .cookie-toggle span {
        display: block;
        width: 2.8rem;
        height: 1.55rem;
        padding: 0.2rem;
        background: #41464d;
        border-radius: 999px;
        cursor: pointer;
        transition: background 160ms ease;
    }

    .cookie-toggle span::after {
        display: block;
        width: 1.15rem;
        height: 1.15rem;
        content: "";
        background: #f3f4f6;
        border-radius: 50%;
        transition: transform 160ms ease;
    }

    .cookie-toggle input:checked + span {
        background: #a7adb4;
    }

    .cookie-toggle input:checked + span::after {
        transform: translateX(1.25rem);
    }

    .cookie-toggle input:focus-visible + span {
        outline: 2px solid #fff;
        outline-offset: 3px;
    }

    .cookie-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.65rem;
        margin-top: 1.25rem;
    }

    .cookie-button {
        min-height: 2.8rem;
        padding: 0.55rem 0.7rem;
        color: #f3f4f6;
        background: transparent;
        border: 1px solid rgb(217 220 223 / 35%);
        font: inherit;
        font-size: 0.78rem;
        cursor: pointer;
        transition: background 160ms ease, color 160ms ease;
    }

    .cookie-button:hover {
        color: #0d0f13;
        background: #d9dcdf;
    }

    .cookie-button-primary {
        color: #0d0f13;
        background: #d9dcdf;
        border-color: #d9dcdf;
    }

    .cookie-button-primary:hover {
        background: #fff;
    }

    .cookie-button-text {
        grid-column: 1 / -1;
        min-height: 1.9rem;
        border: 0;
        text-decoration: underline;
        text-underline-offset: 0.2rem;
    }

    .cookie-policy {
        margin: 0.65rem 0 0;
        font-size: 0.68rem;
    }

    .cookie-policy a {
        color: #f3f4f6;
        text-underline-offset: 0.2rem;
    }

    .cookie-close {
        position: absolute;
        top: 0.7rem;
        right: 0.7rem;
        width: 1.75rem;
        height: 1.75rem;
        color: #c3c7ca;
        background: transparent;
        border: 1px solid rgb(217 220 223 / 30%);
        font-size: 1.4rem;
        line-height: 1;
        cursor: pointer;
    }

    .cookie-close[hidden] {
        display: none;
    }

    @media (max-width: 420px) {
        .cookie-dialog {
            inset: auto 0.5rem 0.5rem;
            width: calc(100vw - 1rem);
            max-height: 75dvh;
        }

        .cookie-content {
            padding: 1.15rem 1rem;
        }

        .cookie-actions {
            grid-template-columns: 1fr;
        }

        .cookie-button-text {
            grid-column: auto;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .cookie-toggle span,
        .cookie-toggle span::after,
        .cookie-button {
            transition: none;
        }
    }
</style>
