---
import Layout from "../layouts/Layout.astro";
import BookingForm from "../components/BookingForm/BookingForm";
import { photographyBookingConfig } from "../components/BookingForm/schema/bookingFormConfig";
import { isBookingServiceId } from "../data/services";

const rawService = Astro.url.searchParams.get("service");
const initialService = isBookingServiceId(rawService) ? rawService : undefined;

const title = "Reservar una sesión | Moisés Magariño";
const description =
	"Reserva tu sesión fotográfica con Moisés Magariño. Cuéntame el servicio, la fecha, la hora y el lugar del evento.";
---

<Layout title={title} description={description}>
	<section class="relative overflow-hidden px-6 pb-24 pt-32 sm:pt-40">
		<div
			aria-hidden="true"
			class="pointer-events-none absolute left-1/2 top-24 h-72 w-[36rem] -translate-x-1/2 rounded-full bg-white/5 blur-3xl"
		></div>

		<div class="relative mx-auto mb-10 max-w-3xl text-center">
			<span
				class="mb-5 inline-block rounded-full border border-white/15 px-4 py-1 text-xs font-medium uppercase tracking-[0.18em] text-(--color-text-primary)"
			>
				Reservas
			</span>
			<h1
				class="title-font mb-5 text-4xl font-bold leading-tight text-gray-100 sm:text-5xl lg:text-6xl"
			>
				<span class="gradiente-title-g">Reserva tu sesión</span>
			</h1>
			<p class="mx-auto max-w-[62ch] leading-7 text-gray-300 sm:text-lg">
				Cuéntame qué servicio necesitas, cuándo y dónde será el evento.
				Revisaré tu solicitud y te responderé para confirmar los detalles.
			</p>
		</div>

		<div class="relative mx-auto flex w-full max-w-3xl justify-center">
			<BookingForm
				client:load
				config={photographyBookingConfig}
				initialService={initialService}
			/>
		</div>
	</section>
</Layout>
