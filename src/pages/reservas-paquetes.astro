---
import Layout from "../layouts/Layout.astro";
import PackageBookingForm from "../components/PackageBookingForm/PackageBookingForm";
import { packageBookingConfig } from "../components/PackageBookingForm/schema/packageBookingConfig";

const title = "Reserva un paquete | Moisés Magariño";
const description =
	"Elige tu paquete Black & White Moments y comparte los detalles de tu evento para solicitar una reserva.";
---

<Layout title={title} description={description}>
	<section class="relative overflow-hidden px-6 pb-24 pt-32 sm:pt-40">
		<div
			aria-hidden="true"
			class="pointer-events-none absolute left-1/2 top-24 h-72 w-[36rem] -translate-x-1/2 rounded-full bg-white/5 blur-3xl"
		></div>

		<div class="relative mx-auto mb-10 max-w-3xl text-center">
			<span
				class="mb-5 inline-block rounded-full border border-white/15 px-4 py-1 text-xs font-medium uppercase tracking-[0.18em] text-(--color-text-primary)"
			>
				Black &amp; White Moments
			</span>
		</div>

		<div class="relative mx-auto flex w-full max-w-3xl justify-center">
			<PackageBookingForm client:load config={packageBookingConfig} />
		</div>
	</section>
</Layout>
