---
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import ButtonPrimary from "../components/ButtonPrimary.astro";
import ButtonShine from "../components/ButtonShine.astro";
import imagenBodas from "../assets/pagina web fotos y video/web bodas/DO-459.jpg";
import imagenEventos from "../assets/pagina web fotos y video/web eventos/DSC00083-Mejorado-NR.jpg";
import imagenRealState from "../assets/pagina web fotos y video/web realstate/DSC01319.JPG";
import imagenPhotoshoot from "../assets/pagina web fotos y video/web photoshoot/DSC06344.JPG";

const services = [
  {
    title: "Bodas",
    image: imagenBodas,
    href: "/galeria/bodas/",
    description: `Cobertura fotográfica para bodas, engagements y celebraciones íntimas en Miami, Fort Lauderdale, Coral Gables y todo el sur de Florida.`,
  },
  {
    title: "Real Estate",
    image: imagenRealState,
    href: "/galeria/real-estate/",
    description: `Fotografía profesional para propiedades, alquileres, vendedores, desarrollos y agentes inmobiliarios con estilo premium.`,
  },
  {
    title: "Eventos y Conciertos",
    image: imagenEventos,
    href: "/galeria/eventos/",
    description: `Captura la energía, emoción y atmósfera de conciertos, fiestas, festivales y eventos de gran escala en Miami.`,
  },
  {
    title: "Photoshoot",
    image: imagenPhotoshoot,
    href: "/galeria/photoshoot/",
    description: `Retratos corporativos, lifestyle, headshots y sesiones personales con una estética elegante y auténtica.`,
  },
];
---

<section
  id="servicios"
  class="w-full h-fit flex md:items-center relative text-gray-600 body-font md:py-20"
>
  <div
    class=`flex flex-col md:flex-row md:gap-10 lg:max-w-7xl xl:gap-10  mx-auto py-10 md:py-1 px-6 md:px-14 items-center relative z-10 `
  >
    <!-- col-1 : sticky de 100dvh con contenido centrado.
         Nunca invade lo de arriba: el sticky viaja dentro de su contenedor
         y el centrado lo hace justify-center, no translate(). -->
    <div
      class="w-full flex flex-col mb-16 md:mb-40 items-center text-center servicios-copy gap-4 md:sticky md:top-0 md:h-dvh md:w-2/4 md:self-start md:justify-center md:items-start md:text-left"
    >
      <span
        class="btn-item-service text-[1.4em]
         px-3 py-1
         rounded-3xl
         
         border-[0.1rem]
         font-light"
      >
        • Mis Servicios
      </span>
      <h2
        class="max-w-3xl text-center md:text-start font-serif text-4xl font-normal leading-[1.05] text-white sm:text-5xl lg:text-6xl"
      >
        Imágenes para volver a sentir cada instante.
      </h2>
      <p
        class="md:max-w-[58ch] mb-8 leading-relaxed font-normal text-[1em] text-gray-500"
      >
        Capturo recuerdos auténticos, emociones reales y detalles que transmiten
        estilo para bodas, eventos, propiedades y personal brands en Miami, Fort
        Lauderdale, Palm Beach y toda la costa de Florida.
      </p>
      <ul class="flex flex-col gap-4 text-[1.1em]"></ul>

      <div class="flex justify-center">
        <ButtonShine
          href="https://wa.link/c24rca"
          class="w-full flex items-center justify-center border border-[#d9dde0]/70 px-5 py-3 text-sm font-medium text-[#e3e6e8] sm:w-fit"
          text="Contactar"
        >
          <Icon name="whatsapp-solid" size={19} />
        </ButtonShine>
      </div>
    </div>
    <!-- col-2-->
    <div class="md:w-2/4 grid md:grid-cols-1 grid-cols-1 gap-10">
      {
        services.map((service) => {
          return (
            <a
              href={service.href}
              aria-label={`Ver galería de ${service.title}`}
              class="card-servicio group relative flex flex-col gap-3 overflow-hidden rounded-2xl p-0 text-(--color-brand-secundary)"
            >
              <Picture
                src={service.image}
                alt={service.title}
                class="h-72 sm:h-80 md:h-96 w-full object-cover object-top transition-[filter] duration-300 group-hover:brightness-110"
                formats={["avif", "webp"]}
                widths={[384, 640, 960]}
                sizes="(min-width: 1280px) 600px, (min-width: 768px) 50vw, calc(100vw - 3rem)"
                quality={75}
                loading="lazy"
                decoding="async"
              />

              {/* Overlay oscuro parejo: misma opacidad en toda la tarjeta
                  para que la foto y el título se lean igual en todo el marco */}
              <div
                aria-hidden="true"
                class="absolute inset-0 bg-black/60"
              />

              <div class="absolute inset-0 flex items-center justify-center px-6">
                <span class="service-btn inline-flex items-center justify-center rounded-full border-2 border-white/80 bg-transparent px-6 py-3 text-center text-xl font-medium leading-snug text-white transition-colors duration-300 group-hover:border-white group-hover:bg-white/10 lg:text-2xl xl:text-3xl [text-shadow:0_2px_4px_rgba(0,0,0,0.6),0_4px_12px_rgba(0,0,0,0.45)]">
                  {service.title}
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .btn-item-service {
    color: var(--color-text-primary);
    border: 1px solid
      color-mix(
        in oklab,
        var(--color-gray-900) 50%,
        var(--color-brand-secundary)
      );
  }
</style>

<script>
    // Animación sincronizada con scroll (mismo patrón que Hero/SkiperParallax):
    // col-1 (badge → título → descripción → botón) en cascada,
    // y cada tarjeta de la "galería" aparece cuando entra en pantalla.
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const section = document.getElementById("servicios");

    if (
        section &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
        // 1) Copia sticky: los elementos principales uno detrás de otro
        const copy = section.querySelector(".servicios-copy");
        if (copy) {
            gsap.from(copy.children, {
                autoAlpha: 0,
                y: 28,
                duration: 0.7,
                ease: "power3.out",
                stagger: 0.18, // cada elemento entra tras el anterior
                scrollTrigger: {
                    trigger: section,
                    start: "top 70%", // cuando la sección se acerca al viewport
                },
            });
        }

        // 2) "Galería": progresivo con el scroll — cada tarjeta se
        //    revela al entrar, una tras otra, sin saltarse ninguna.
        section.querySelectorAll(".card-servicio").forEach((card) => {
            gsap.from(card, {
                autoAlpha: 0,
                y: 48,
                scale: 0.97,
                duration: 0.7,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: card,
                    start: "top 85%",
                },
            });
        });
    }
</script>
